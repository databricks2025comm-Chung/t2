{
  "name": "Ingestion — Azure DevOps / Work Items",
  "job_clusters": [
    {
      "job_cluster_key": "ingestion_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "Standard_DS3_v2",
        "num_workers": 2
      }
    }
  ],
  "parameters": [
    { "name": "source_id", "default": "1" },
    { "name": "entity_id", "default": "ADO_BOARDS_WORKITEMS" },
    { "name": "log_level", "default": "INFO" }
  ],
  "tasks": [
    {
      "task_key": "extract",
      "job_cluster_key": "ingestion_cluster",
      "notebook_task": {
        "notebook_path": "/Ingestion/01_Entity_Extractor",
        "base_parameters": {
          "source_id":    "{{job.parameters.source_id}}",
          "entity_id":    "{{job.parameters.entity_id}}",
          "run_id": "{{job.run_id}}",
          "log_level":    "{{job.parameters.log_level}}"
        }
      },
      "timeout_seconds": 3600,
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": false
    }
  ],
  "schedule": {
    "quartz_cron_expression": "0 0 5 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "email_notifications": {
    "on_failure": ["abc@.com"]
  },
  "max_concurrent_runs": 1
}
