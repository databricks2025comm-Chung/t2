# =============================================================================
# Token expiry fix: store expires_at on the token_cache row and check it on read
# =============================================================================
# What this fixes
#   - _FRESH_EXPIRES_IN is written by the three OAuth helpers but never read
#     (its only reader, prefetch_token(), is dead).
#   - Extractors accept any token row regardless of age, so a stale row costs
#     every entity a 401 plus a 1-3 s jitter sleep.
#
# Where each block goes
#   STEP 0  SQL, run once
#   STEP 1  _lib/auth   constants (replace the _FRESH_EXPIRES_IN / _PREFETCH_* block)
#   STEP 2  _lib/auth   replace write_token_cache and read_token_cache,
#                       add is_token_usable and fetch_and_store_token
#   STEP 3  00_Orchestrator_Ingestion   replace the TOKEN PREFETCH cell
#   STEP 4  01_Entity_Extractor         replace the TOKEN LOAD block and token_refresher
#
# The three OAuth helpers (_get_ado_oauth_headers, _get_snow_oauth_headers,
# _get_github_app_headers) need NO code change. They already set
# _FRESH_EXPIRES_IN[key_prefix] after every live fetch.
#
# Delete from _lib/auth (legacy, unused):
#   _PREFETCH_IN_PROGRESS, _PREFETCH_KEY_SUFFIX, _SECRETS_API_TIMEOUT,
#   _read_prefetched_token, _write_prefetched_token, prefetch_token
# =============================================================================


# -----------------------------------------------------------------------------
# STEP 0  (SQL, run once BEFORE deploying the code below)
# -----------------------------------------------------------------------------
# ALTER TABLE catalog.ingestion.token_cache ADD COLUMN expires_at TIMESTAMP;
#
# Existing rows get NULL expires_at. The code treats NULL as "not usable", so
# the first run after deployment does one live fetch and fills it in.


# -----------------------------------------------------------------------------
# STEP 1  _lib/auth: constants
# -----------------------------------------------------------------------------

# expires_in (seconds) captured by the three OAuth helpers on every live fetch.
# fetch_and_store_token() reads and pops it, so the dict never grows.
_FRESH_EXPIRES_IN: dict = {}

# Treat a token as expired this many seconds before the IdP says it expires,
# so an entity never starts a long run on a token with seconds left.
_EXPIRY_SAFETY_MARGIN_SEC: int = 300

# Used only when the IdP response carries no lifetime.
_DEFAULT_EXPIRES_IN: dict = {
    "ADO_OAUTH":  3600,
    "SNOW_OAUTH": 1800,
    "GITHUB_APP": 3600,
}


# -----------------------------------------------------------------------------
# STEP 2  _lib/auth: token table functions
# -----------------------------------------------------------------------------

def _as_utc(ts):
    """Spark returns naive datetimes; this framework treats them as UTC."""
    if ts is not None and ts.tzinfo is None:
        return ts.replace(tzinfo=_timezone.utc)
    return ts


def write_token_cache(
    source_name:     str,
    encrypted_token: str,
    ttl_seconds:     int,
    log:             "ContextLogger",
) -> None:
    """
    Upsert (source_name, encrypted_token, fetched_at, expires_at).

    expires_at is computed inside Spark as current_timestamp() + ttl, so
    fetched_at and expires_at come from the same clock and no timezone
    conversion is involved. Non-fatal: logs a warning on any error.
    """
    try:
        _s   = source_name.replace("'", "''")
        _e   = encrypted_token.replace("'", "''")
        _ttl = max(int(ttl_seconds), 0)
        spark.sql(f"""
            MERGE INTO {_TOKEN_CACHE_TABLE} AS t
            USING (
                SELECT '{_s}' AS source_name,
                       '{_e}' AS encrypted_token,
                       current_timestamp()                          AS fetched_at,
                       current_timestamp() + INTERVAL {_ttl} SECONDS AS expires_at
            ) AS s
            ON t.source_name = s.source_name
            WHEN MATCHED THEN
                UPDATE SET t.encrypted_token = s.encrypted_token,
                           t.fetched_at      = s.fetched_at,
                           t.expires_at      = s.expires_at
            WHEN NOT MATCHED THEN
                INSERT (source_name, encrypted_token, fetched_at, expires_at)
                VALUES (s.source_name, s.encrypted_token, s.fetched_at, s.expires_at)
        """)
        log.debug(f"Token cache written  source={source_name}  ttl={_ttl}s")
    except Exception as exc:
        log.warning(f"Token cache write failed  source={source_name}  error={exc}")


def read_token_cache(source_name: str, log: "ContextLogger"):
    """
    Returns (encrypted_token, fetched_at, expires_at), or ("", None, None) on
    any miss or error. Datetimes are timezone-aware UTC.

    NOTE: returns 3 values now (was 2). Both callers in 01 are updated in STEP 4.
    If the expires_at column does not exist yet, the select fails, the except
    below logs a warning and returns a miss, so extractors fall back to a live
    fetch instead of crashing.
    """
    try:
        from pyspark.sql.functions import col as _col
        rows = (
            spark.read.table(_TOKEN_CACHE_TABLE)
            .filter(_col("source_name") == source_name)
            .select("encrypted_token", "fetched_at", "expires_at")
            .limit(1)
            .collect()
        )
        if rows:
            return (
                rows[0]["encrypted_token"] or "",
                _as_utc(rows[0]["fetched_at"]),
                _as_utc(rows[0]["expires_at"]),
            )
    except Exception as exc:
        log.warning(f"Token cache read failed  source={source_name}  error={exc}")
    return "", None, None


def is_token_usable(expires_at) -> bool:
    """True only when the row has an expiry and it is still in the future."""
    return expires_at is not None and expires_at > _datetime.now(_timezone.utc)


def fetch_and_store_token(
    auth_type:   str,
    source_name: str,
    log:         "ContextLogger",
    base_url:    str,
) -> dict:
    """
    Live fetch -> encrypt -> MERGE into token_cache (with expires_at).
    Returns the full headers dict. Use ONLY for OAuth types that go through
    the table (ADO_OAUTH, SNOW_OAUTH, GITHUB_APP).

    Replaces the same four-step sequence that was written out twice, once in
    00 (prefetch) and once in 01 (token_refresher).
    """
    key_prefix = source_name.lower().replace(" ", "-")

    headers = get_auth_headers(auth_type, source_name, log, base_url)
    raw     = headers["Authorization"].split(" ", 1)[1]    # drop "Bearer "

    expires_in = _FRESH_EXPIRES_IN.pop(
        key_prefix, _DEFAULT_EXPIRES_IN.get(auth_type.upper(), 3600)
    )
    ttl = max(expires_in - _EXPIRY_SAFETY_MARGIN_SEC, 0)

    enc = encrypt_token(raw, log)
    if enc:
        write_token_cache(source_name, enc, ttl, log)
    return headers


# -----------------------------------------------------------------------------
# STEP 3  00_Orchestrator_Ingestion: replace the whole TOKEN PREFETCH cell
# -----------------------------------------------------------------------------
# Removes _enc_token, _key_prefix and every _PREFETCH_IN_PROGRESS line.

_OAUTH_PREFETCH_TYPES = {"ADO_OAUTH", "SNOW_OAUTH", "GITHUB_APP"}

if config_rows[0]["auth_type"].upper() in _OAUTH_PREFETCH_TYPES:
    try:
        fetch_and_store_token(
            config_rows[0]["auth_type"],
            source_name,
            log,
            config_rows[0]["base_url"],
        )
        log.info(
            f"Token prefetched, encrypted and stored  "
            f"auth_type={config_rows[0]['auth_type']}  "
            f"entity_count={len(entities)}"
        )
    except Exception as _prefetch_exc:
        log.warning(
            f"Token prefetch failed, extractors will fetch their own tokens  "
            f"error={_prefetch_exc}"
        )


# -----------------------------------------------------------------------------
# STEP 4a  01_Entity_Extractor: replace the "if _is_oauth: ... else: ..." block
#          that builds auth_headers at startup (keep the _OAUTH_TYPES,
#          _is_oauth and _my_token_ts lines above it)
# -----------------------------------------------------------------------------

if _is_oauth:
    _enc_db, _ts_db, _exp_db = read_token_cache(cfg.source_name, log)

    _reason = None
    if not _enc_db:
        _reason = "no row in token table"
    elif not is_token_usable(_exp_db):
        _reason = f"row expired or has no expiry  expires_at={_exp_db}"
    else:
        try:
            _raw_token   = decrypt_token(_enc_db, log)
            auth_headers = build_auth_headers_from_token(cfg.auth_type, _raw_token)
            _my_token_ts = _ts_db
            log.info(
                f"Auth: token loaded from table  auth_type={cfg.auth_type}  "
                f"expires_at={_exp_db}"
            )
        except Exception as _dec_exc:
            _reason = f"decrypt failed  error={_dec_exc}"

    if _reason:
        # Live fetch that also writes the table, so peers can reuse it.
        auth_headers = fetch_and_store_token(
            cfg.auth_type, cfg.source_name, log, cfg.base_url
        )
        _my_token_ts = datetime.now(timezone.utc)
        log.info(f"Auth: live fetch and stored  reason={_reason}  auth_type={cfg.auth_type}")
else:
    auth_headers = get_auth_headers(cfg.auth_type, cfg.source_name, log, cfg.base_url)
    log.info(f"Auth: live fetch  auth_type={cfg.auth_type}")


# -----------------------------------------------------------------------------
# STEP 4b  01_Entity_Extractor: replace token_refresher()
# -----------------------------------------------------------------------------

def token_refresher() -> dict:
    """
    On 401: jitter, re-read the table, use a peer's newer token if there is
    one, otherwise live fetch and store. Non-OAuth types: straight live fetch.
    """
    import random as _random
    import time   as _rt
    global _my_token_ts

    if not _is_oauth:
        return get_auth_headers(cfg.auth_type, cfg.source_name, log, cfg.base_url)

    _rt.sleep(_random.uniform(1.0, 3.0))

    _enc_db, _ts_db, _exp_db = read_token_cache(cfg.source_name, log)
    if (
        _enc_db
        and _ts_db is not None and _ts_db > _my_token_ts   # a peer refreshed after us
        and is_token_usable(_exp_db)                        # and its token is still good
    ):
        try:
            _raw = decrypt_token(_enc_db, log)
            _h   = build_auth_headers_from_token(cfg.auth_type, _raw)
            _my_token_ts = _ts_db
            log.info(f"Token refreshed from table (peer refreshed first)  source={cfg.source_name}")
            return _h
        except Exception as _e:
            log.warning(f"Table token decrypt failed in refresher, live fetch  error={_e}")

    _new_h = fetch_and_store_token(cfg.auth_type, cfg.source_name, log, cfg.base_url)
    _my_token_ts = datetime.now(timezone.utc)
    log.info(f"Token refreshed by live fetch and stored  source={cfg.source_name}")
    return _new_h
